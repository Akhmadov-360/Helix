{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Helix Vite + React",
  "extends": "./base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",

    "jsx": "react-jsx",
    "useDefineForClassFields": true,

    "noEmit": true,
    "types": ["vite/client"]
  }
}
