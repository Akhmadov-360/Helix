    "lint": "eslint ."
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "openai": "^4.77.0"
  },
  "devDependencies": {
    "@helix/eslint-config": "workspace:*",
    "@helix/typescript-config": "workspace:*",
    "@types/node": "^22.18.9",
    "eslint": "^9.39.0",
    "typescript": "^5.9.3"
  }
