# apps/api runtime env — валидируется @helix/config на старте (падает при невалидном).
NODE_ENV=development
PORT=3000

# Port 5433 — docker-compose мапит postgres туда (см. CLAUDE.md Gotchas).
DATABASE_URL="postgresql://helix:helix@localhost:5433/helix?schema=public"

# Auth (M0, docs/specs/auth.md) — ОБЯЗАТЕЛЕН, минимум 32 символа.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="change-me-generate-your-own-32-chars-minimum"
# TTL access-токена (по умолчанию 15m, если не задан).
# JWT_EXPIRES_IN="15m"

# CORS: origin apps/web (по умолчанию http://localhost:5173, если не задан).
# WEB_ORIGIN="http://localhost:5173"

# Redis (M2, BullMQ) — ОБЯЗАТЕЛЕН, порт 6379 из docker-compose.dev.yml.
REDIS_URL="redis://localhost:6379"

# M3+ (пока опциональны):
# S3_ENDPOINT="http://localhost:9000"
# S3_REGION="us-east-1"
# S3_ACCESS_KEY="helix"
# S3_SECRET_KEY="helixsecret"
# S3_BUCKET="helix-uploads"
