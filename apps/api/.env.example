# apps/api runtime env — валидируется @helix/config на старте (падает при невалидном).
NODE_ENV=development
PORT=3000

# Port 5433 — docker-compose мапит postgres туда (см. CLAUDE.md Gotchas).
DATABASE_URL="postgresql://helix:helix@localhost:5433/helix?schema=public"

# Auth (M0, docs/specs/auth.md) — ОБЯЗАТЕЛЕН, минимум 32 символа.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="change-me-generate-your-own-32-chars-minimum"
# TTL access-токена (по умолчанию 15m, если не задан).
# JWT_EXPIRES_IN="15m"

# CORS: origin apps/web (по умолчанию http://localhost:5173, если не задан).
# WEB_ORIGIN="http://localhost:5173"

# Redis (M2, BullMQ) — ОБЯЗАТЕЛЕН, порт 6379 из docker-compose.dev.yml.
REDIS_URL="redis://localhost:6379"

# Notifications (M2, docs/specs/notifications.md §8) — ОБЯЗАТЕЛЕН.
# MAIL_PROVIDER=smtp → MailHog (docker-compose.dev.yml), письма на http://localhost:8025.
# MAIL_PROVIDER=ses → нужен только SES_REGION (креды — IAM role, не env-переменные, §7).
MAIL_PROVIDER="smtp"
MAIL_FROM="noreply@helix.dev"
APP_URL="http://localhost:5173"
SMTP_HOST="localhost"
SMTP_PORT=1025
# SMTP_USER / SMTP_PASS — пусто в деве (MailHog не проверяет auth). В проде с реальным
# провайдером (Resend/SendGrid/Mailgun и т.п.) — обязательны, иначе провайдер отклонит соединение.
# SMTP_USER="resend"
# SMTP_PASS="re_..."
# SES_REGION="us-east-1"

# Files (M3, docs/specs/files.md §12) — S3_BUCKET ОБЯЗАТЕЛЕН, остальные условны на провайдере.
# Задан S3_ENDPOINT → MinIO (dev, docker-compose.dev.yml); не задан → настоящий AWS S3 (prod,
# креды — IAM role, тот же принцип, что SES_REGION выше).
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY="helix"
S3_SECRET_KEY="helixsecret"
S3_BUCKET="helix-uploads"

# AI / RAG (M4, docs/specs/ai-chat.md §9) — все опциональны, провайдер выбирается per-org.
# Нужен хотя бы один, чтобы Talk-to-Project вообще заработал для какой-либо орги.
# ANTHROPIC_API_KEY="sk-ant-..."
# OPENAI_API_KEY="sk-..."          # также обслуживает embeddingProvider="openai"
# AWS_BEDROCK_REGION="us-east-1"   # креды — IAM role, тот же принцип, что SES_REGION
