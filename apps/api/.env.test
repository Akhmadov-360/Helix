# Окружение тестов. Не секрет — коммитится намеренно, чтобы прогон заводился «из коробки».
NODE_ENV=test

# Порт 5434 — отдельный сервис helix-test-db (эфемерный, tmpfs).
# НИКОГДА не указывать сюда dev-БД (5433): beforeEach делает TRUNCATE всех таблиц.
DATABASE_URL="postgresql://helix:helix@localhost:5434/helix_test?schema=public"

# Тот же redis-контейнер, что dev (нет отдельного test-инстанса) — отдельный logical DB (/1,
# не /0) хотя бы не смешивает job'ы тестов с ручным dev-прогоном на одном сервере.
REDIS_URL="redis://localhost:6379/1"

# Notifications (M2) — тесты не шлют реальную почту, но env обязателен (boot-time валидация).
MAIL_PROVIDER="smtp"
MAIL_FROM="noreply@helix.dev"
APP_URL="http://localhost:5173"
SMTP_HOST="localhost"
SMTP_PORT=1025

# Фиктивный секрет только для тестов (>=32 символов по схеме env).
JWT_SECRET="test-only-secret-not-for-production-0123456789"

# Files (M3) — тот же MinIO-контейнер, что dev, отдельный бакет (docs/specs/files.md §14).
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY="helix"
S3_SECRET_KEY="helixsecret"
S3_BUCKET="helix-test"
